# Base path the app is served from. "/" locally; the deploy workflow sets /<repository>/.
VITE_BASE=/

# Data endpoints. The Content Security Policy only allows the origins listed here.
VITE_OSM_API_URL=https://api.openstreetmap.org
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# OSM OAuth2 applications. Only needed once editing is available.
VITE_OSM_CLIENT_ID_PROD=
VITE_OSM_CLIENT_ID_DEV=
VITE_OSM_REDIRECT_URI=
